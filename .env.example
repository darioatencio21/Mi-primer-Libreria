# Base de datos local (Postgres en Docker). Fuera del stack podés
# apuntar a localhost (ver docker-compose*.yml).
DATABASE_URL=postgres://postgres:librostuc@localhost:5432/librostuc

# --- Admin ---
ADMIN_PASS=cambia-esta-password
ADMIN_SESSION_SECRET=cambia-este-secreto-por-uno-aleatorio

# --- Conversión de precios (USD -> ARS) ---
AR_USD_RATE=1300

# --- Integración con SaaS externo (opcional, ver docs/saas-integration.md) ---
# Proveedores activos:
#   CATALOG_PROVIDER   = postgres | saas   (dónde se lee el catálogo de libros)
#   ORDERS_PROVIDER    = postgres | erp      (dónde se crean los pedidos)
#   INVENTORY_PROVIDER = postgres | erp      (dónde se gestiona el stock)
#   PAYMENT_PROVIDER   = manual   | merchant (cómo se cobra)
CATALOG_PROVIDER=postgres
ORDERS_PROVIDER=postgres
INVENTORY_PROVIDER=postgres
PAYMENT_PROVIDER=manual

# URLs y tokens del SaaS externo (solo si el proveedor correspondiente es
# 'saas', 'erp' o 'merchant'). El catálogo usa la API REST de Camaleón
# (precios en ARS). CATALOG_API_TENANT_SLUG es el multi-tenant (X-Tenant-Slug).
# CATALOG_API_URL=https://mi-saas.example.com/api
# CATALOG_API_TOKEN=tu-token
# CATALOG_API_TENANT_SLUG=mi-negocio
# ERP_API_URL=https://mi-saas.example.com/api
# ERP_API_TOKEN=tu-token
# MERCHANT_API_URL=https://mi-pasarela.example.com
# MERCHANT_API_TOKEN=tu-token