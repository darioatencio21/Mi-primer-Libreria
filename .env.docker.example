# ============================================================
#  TU LIBROS YA — Variables para Docker (.env.docker)
#  Copiá a `.env.docker` y completá según tu caso.
#  Este archivo NO se commitea (ver .gitignore).
# ============================================================

# ---------- Base de datos (Docker) ----------
# La app construye la URL usando el servicio `db` del compose.
# Podés ajustar el usuario/contraseña/name con estas:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=librostuc
POSTGRES_DB=librostuc

# Si la app corre FUERA de Docker contra este postgres:
# DATABASE_URL=postgres://postgres:librostuc@localhost:5432/librostuc

# ---------- Admin ----------
ADMIN_PASS=Libros123
ADMIN_SESSION_SECRET=a7f3c91e55d2a8b64c0f91b7e50d23a6c4e8f12ab9d3c47e92f5a1b8c6d4e0f3

# ---------- Conversión de precios (USD -> ARS) ----------
AR_USD_RATE=1300

# ---------- Proveedores (ver docs/saas-integration.md) ----------
# La app lee/escribe en el postgres local (adaptadores "postgres").
CATALOG_PROVIDER=postgres
ORDERS_PROVIDER=postgres
INVENTORY_PROVIDER=postgres
PAYMENT_PROVIDER=manual

# URLs y tokens del SaaS externo (solo si el proveedor correspondiente es
# 'saas', 'erp' o 'merchant'). El catálogo usa GraphQL.
# CATALOG_API_URL=https://mi-saas.example.com/graphql
# CATALOG_API_TOKEN=tu-token
# ERP_API_URL=https://mi-saas.example.com
# ERP_API_TOKEN=tu-token
# MERCHANT_API_URL=https://mi-pasarela.example.com
# MERCHANT_API_TOKEN=tu-token